; beszel-agent's container: container_t's files and host networking (the
; udica templates base_container and net_container), plus a connect to
; podman-api-proxy, its one peer outside the container. Its own type, not
; container_t, so that connect isn't open to every container on the host.
;
; Use: SecurityLabelType=beszel_agent.process
(block beszel_agent
	; The account runs as user_u (forma maps it), so its containers run under
	; user_r. The udica templates associate a type with system_r only.
	(roletype user_r process)

	(blockinherit container)
	(blockinherit net_container)

	; The proxy's socket (beszel_api_proxy.te). Only connectto: no file, dir or
	; process access to the proxy. The socket file itself is container_file_t,
	; in the beszel-agent-api volume.
	(allow process beszel_api_proxy_t (unix_stream_socket (connectto)))
)
